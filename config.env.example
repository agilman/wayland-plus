# wayland-plus configuration
# Copy this file to ~/.config/wayland-plus/config.env and edit.
# config.env is gitignored — your coordinates never leave your machine.

# Decimal coordinates for AQI lookups (AirNow + Open-Meteo)
LAT=0.0
LON=0.0

# IANA timezone for the AQI forecast chart x-axis (e.g. America/Los_Angeles)
TZ=UTC

# Display name used in notification titles (optional; may be empty)
CITY=Your City
